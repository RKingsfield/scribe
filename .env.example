# Copy to .env and reference from docker compose via `env_file: .env`.
# Full descriptions for every variable: docs/DEVELOPERS_GUIDE.md → Configuration.

PORT=3030
WRITING_ROOT=/data/writing
APPDATA_ROOT=/data/appdata

# OpenAI-compatible LLM endpoint for chat / rewrite / summarize
ORCHESTRATOR_URL=http://localhost:11435
# Enables Claude models in the model picker
#ANTHROPIC_API_KEY=

# RAG query support (optional)
#QDRANT_URL=http://localhost:6333
#QDRANT_API_KEY=
#EMBED_URL=http://localhost:8090
RAG_RECIPES_DIR=/data/rag/recipes
#RAG_HOST_RECIPES_DIR=/data/rag/recipes
#RAG_HOST_WRITING_ROOT=/data/writing

# Per-novel git push (optional). Token is stored in each novel's .git/config —
# scope it to per-repo push access.
#FORGEJO_BASE_URL=
#FORGEJO_USER=
#FORGEJO_TOKEN=

GIT_AUTHOR_NAME=Scribe Auto
GIT_AUTHOR_EMAIL=scribe@scribe.local
#SCRIBE_AUTOCOMMIT_DISABLED=1
AUTOCOMMIT_INTERVAL_MIN=10

# Webhook alert on autocommit failure (optional). STYLE: json or ntfy
#ALERT_WEBHOOK_URL=
#ALERT_WEBHOOK_TOKEN=
#ALERT_WEBHOOK_STYLE=json
